# ==============================================================================
# Zee Sip Distributor Portal - Environment Variables
# ==============================================================================

# 1. Admin Authentication Password (Only evaluated on the server)
# Used for the single-field "Admin" login tab on the landing page
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# 2. Session Secret for JWT signing (jose library, HS256)
# Minimum 32 characters random string recommended
SESSION_SECRET=change_this_to_a_random_32_character_secret_key_zeesip

# 3. Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 4. Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 5. Direct Database Connection (Optional / Alternative fallback adapter)
# Connection string with postgres user directly bypassing RLS:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=
