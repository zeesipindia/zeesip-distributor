# ==============================================================================
# Zee Sip Distributor Portal - Environment Variables
# ==============================================================================

# 1. Admin Master Password
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# 2. Pepper for Password Lookup Hash (HMAC-SHA256, long random string, SERVER ONLY)
PASSWORD_PEPPER=change_this_to_a_long_random_pepper_string_for_password_lookup_zeesip

# 3. Session Secret for JWT signing (jose library, HS256)
SESSION_SECRET=change_this_to_a_random_32_character_secret_key_zeesip

# 4. Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 5. Supabase Service Role Key (SERVER ONLY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
